# Copy to .env for local Web, Prisma and Worker. Never commit credentials.
APP_ENV=development
DATA_MODE=demo
KITE_NETWORK=testnet
EC_PROVIDER_MODE=mock
CLAIMS_ENABLED=false
DATABASE_URL=postgresql://kite:kite_local_only@127.0.0.1:5434/kite_bounty?schema=public
APP_ORIGIN=http://127.0.0.1:3000
# Create a development OAuth App with callback:
# http://127.0.0.1:3000/api/auth/github/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_EC_TOKEN=
# EC_UPSTREAM_OWNER=electric-capital
# EC_UPSTREAM_REPOSITORY=open-dev-data
# EC_FORK_OWNER=your-github-account
# EC_FORK_REPOSITORY=open-dev-data
# Comma-separated wallet addresses. Role is granted on the next successful login.
# ADMIN_WALLET_ALLOWLIST=
